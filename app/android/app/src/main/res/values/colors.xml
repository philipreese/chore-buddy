<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#415F91</color>
    <!-- Static Material 3 palette used below API 31 (no dynamic color) and
         as the base fallback if a device somehow lacks the system_* dynamic
         color resources; see values-v31/colors.xml for the API 31+
         wallpaper-derived overrides. -->
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_on_surface">#FF1B1B1F</color>
    <color name="widget_muted">#FF6B6B72</color>
    <color name="widget_overdue">#FFB3261E</color>
    <!-- Circular tap-target fill + glyph for the "mark complete" button,
         matching the app's own primaryContainer/onPrimaryContainer for the
         "Chambray" seed (ColorScheme.fromSeed(0xFF415F91), light) so the
         button reads as the app's own accent pre-API31 too; see
         values-v31/colors.xml for the API31+ dynamic-color equivalents. -->
    <color name="widget_check_container">#FFD6E3FF</color>
    <color name="widget_on_check_container">#FF274777</color>
</resources>
